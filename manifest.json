{
  "id": "family-meals",
  "contexts": ["household", "shared_space"],
  "name": "Family Meals",
  "version": "1.1.0",
  "description": "Plan the week's meals day by day. Pick from your recipe book, assign who's cooking, and add ingredients directly to your grocery list.",
  "entrypoint": "index.html",
  "runtime": "static",
  "storage": "db",
  "preload": {
    "meal_plan": {"sql": "SELECT * FROM app_family_meals__meal_plan ORDER BY plan_date, slot"},
    "favorites": {"sql": "SELECT * FROM app_family_meals__favorites ORDER BY use_count DESC, name"}
  },
  "db_encryption": "off",
  "category": "family",
  "tags": [
    "meals",
    "food",
    "planning",
    "cooking"
  ],
  "data_access": {
    "reads": [
      "family.members",
      "app.recipes.recipes"
    ],
    "writes": [
      "app.grocery.pending_items"
    ]
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "resource_limits": {
    "max_db_bytes": 104857600
  },
  "member_references": {
    "meal_plan": {
      "column": "assigned_to",
      "on_removed": "null"
    }
  },
  "retention": {
    "meal_plan": {
      "default": 90,
      "timestamp_column": "plan_date",
      "override_key": "meal_history"
    }
  },
  "nav": {
    "label": "Meals"
  },
  "widget": {
    "label": "Meals",
    "size": "small"
  },
  "automation_actions": {
    "plan_meal": {
      "title": "Put a meal on the plan",
      "description": "Fill a slot on the meal plan when another app's event fires - a recipe picked, a trip day, a night someone else is cooking. The date comes from the trigger payload.",
      "params": {
        "plan_date": { "type": "text", "label": "Date (YYYY-MM-DD)", "required": true },
        "meal_name": { "type": "text", "label": "What's for that meal", "required": true },
        "slot": {
          "type": "text",
          "label": "Slot",
          "default": "dinner",
          "options": ["breakfast", "lunch", "dinner", "snack"]
        },
        "notes": { "type": "text", "label": "Notes", "default": "" }
      },
      "dedupe": { "table": "meal_plan", "column": "source_event_id" },
      "steps": [
        {
          "op": "insert",
          "table": "meal_plan",
          "values": {
            "id": "$uuid",
            "plan_date": ":plan_date",
            "slot": ":slot",
            "meal_name": ":meal_name",
            "notes": ":notes",
            "created_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT meal_name AS value FROM app_family_meals__meal_plan WHERE plan_date = :today AND slot = 'dinner' LIMIT 1"
    },
    "display": {
      "template": "stat",
      "value": "value",
      "label": "tonight's dinner",
      "empty_hides": true
    }
  },
  "publishes": [
    "meal.planned"
  ],
  "publish_acls": {
    "meal.planned": { "require_role": "member" }
  },
  "agenda": {
    "kind": "meal",
    "source": {
      "kind": "sql",
      "query": "SELECT id AS id, meal_name AS title, slot AS subtitle, plan_date AS when_at, assigned_to AS member_id FROM app_family_meals__meal_plan WHERE plan_date = :today ORDER BY CASE slot WHEN 'breakfast' THEN 0 WHEN 'lunch' THEN 1 WHEN 'dinner' THEN 2 ELSE 3 END LIMIT 10"
    }
  },
  "icon": "\ud83c\udf7d\ufe0f",
  "db_plaintext_columns": [
    "slot",
    "plan_date"
  ],
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": [
      "upcoming_meals",
      "meal_favorites"
    ]
  }
}
